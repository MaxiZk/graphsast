{
  "cwe": 79,
  "name": "Cross-Site Scripting (XSS)",
  "sources": ["req.query", "req.body", "req.params"],
  "sinks": [
    "document.write",
    "innerHTML",
    "outerHTML",
    "insertAdjacentHTML",
    "res.send"
  ],
  "sanitizers": [
    "sanitize",
    "escape",
    "validate",
    "DOMPurify.sanitize",
    "xss"
  ]
}
