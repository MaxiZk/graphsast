{
  "name": "@graphsast/core",
  "version": "0.1.3",
  "description": "Análisis estático de flujo de datos (taint) para JavaScript y TypeScript: SQLi, inyección de comandos, XSS y NoSQLi, con salida SARIF.",
  "license": "MIT",
  "keywords": [
    "sast",
    "security",
    "taint-analysis",
    "static-analysis",
    "sarif",
    "typescript",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiZk/graphsast.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MaxiZk/graphsast#readme",
  "bugs": "https://github.com/MaxiZk/graphsast/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "graphsast": "dist/cli/graphsast.cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "catalog",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "npm run build && node dist/eval/run-benchmark.cli.js",
    "neo4j:probe": "npm run build && node dist/eval/neo4j-probe.js",
    "scan": "npm run build && node dist/cli/graphsast.cli.js",
    "cve:fetch": "npm run build && node dist/eval/cve/fetch-corpus.cli.js",
    "cve:run": "npm run build && node dist/eval/cve/run-cve.cli.js",
    "baseline": "npm run build && node dist/eval/baseline/run-baseline.cli.js",
    "nodegoat": "npm run build && node dist/eval/nodegoat/run-nodegoat.cli.js",
    "prepack": "npm run build && node -e \"const fs = require('node:fs'); fs.cpSync('../../catalog', 'catalog', { recursive: true }); fs.copyFileSync('../../LICENSE', 'LICENSE')\"",
    "postpack": "node -e \"const fs = require('node:fs'); fs.rmSync('catalog', { recursive: true, force: true }); fs.rmSync('LICENSE', { force: true })\""
  },
  "dependencies": {
    "ignore": "^7.0.10",
    "neo4j-driver": "^6.2.0",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
