{
  "cwe": 943,
  "name": "NoSQL Injection / Manipulación de la lógica de consulta de datos",
  "description": "El dato del usuario llega sin acotar a una consulta o una escritura de la base, y cambia a qué documentos alcanza o qué campos toca. En MongoDB no hay SQL que inyectar: lo que se manipula es la estructura de la consulta.",
  "sources": [
    "req.query",
    "req.body",
    "req.params",
    "req.headers",
    "req.cookies",
    "request.query",
    "request.body",
    "request.params",
    "request.headers",
    "ctx.query",
    "ctx.params",
    "ctx.request",
    "ctx.headers",
    "@Body",
    "@Param",
    "@Query",
    "@Headers",
    "@Req",
    "@Request"
  ],
  "sinks": [
    ".save",
    ".create",
    "findByIdAndUpdate",
    "findByIdAndDelete",
    "insertOne",
    "updateOne",
    "findOne",
    "findOneAndUpdate",
    "findOneAndDelete",
    "findOneAndReplace",
    "updateMany",
    "deleteOne",
    "deleteMany",
    "replaceOne",
    "insertMany",
    "countDocuments",
    "aggregate",
    ".$where",
    {
      "callee": ".find",
      "receiver": "^[A-Z][A-Za-z0-9_]*$|\\.collection\\(.*\\)$"
    }
  ],
  "sanitizers": [
    "mongoSanitize",
    "sanitize",
    "validate",
    "escape",
    "String",
    "ObjectId",
    "parseInt",
    "parseFloat",
    "Number"
  ]
}
